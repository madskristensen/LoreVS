<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="LoreVS">
    <Menus>
      <!-- The "Lore" flyout submenu, hosted on the solution node and Open Folder root
           context menus (mirrors how the built-in Git support nests its commands). -->
      <Menu guid="LoreVS" id="LoreSubMenu" priority="0x0600" type="Menu">
        <Parent guid="LoreVS" id="LoreContextGroup"/>
        <Strings>
          <ButtonText>Lore</ButtonText>
        </Strings>
      </Menu>
      <!-- The same "Lore" flyout hosted on item/project node context menus. -->
      <Menu guid="LoreVS" id="LoreFileSubMenu" priority="0x0700" type="Menu">
        <Parent guid="LoreVS" id="LoreFileContextGroup"/>
        <Strings>
          <ButtonText>Lore</ButtonText>
        </Strings>
      </Menu>
      <!-- Toolbar hosted at the top of the Lore Changes tool window. -->
      <Menu guid="LoreVS" id="LoreChangesToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>Lore Changes</ButtonText>
        </Strings>
      </Menu>
      <!-- Toolbar hosted at the top of the Lore History tool window. -->
      <Menu guid="LoreVS" id="LoreHistoryToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>Lore History</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Anchor group placed on each host context menu; carries the Lore submenu. -->
      <Group guid="LoreVS" id="LoreContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE"/>
      </Group>
      <!-- Group inside the Lore submenu that holds every command. -->
      <Group guid="LoreVS" id="MyMenuGroup" priority="0x0600">
        <Parent guid="LoreVS" id="LoreSubMenu"/>
      </Group>
      <!-- Per-file commands group; shown in both Lore submenus via placements. -->
      <Group guid="LoreVS" id="LoreFileGroup" priority="0x0700">
        <Parent guid="LoreVS" id="LoreSubMenu"/>
      </Group>
      <!-- Anchor group carrying the Lore flyout on item/project node menus. -->
      <Group guid="LoreVS" id="LoreFileContextGroup" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
      </Group>
      <!-- Group on the File menu hosting the top-level Clone command (mirrors built-in Git). -->
      <Group guid="LoreVS" id="LoreFileMenuGroup" priority="0x0300">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_FILE"/>
      </Group>
      <!-- Leading group on the Lore Changes toolbar that holds the branch dropdown. -->
      <Group guid="LoreVS" id="LoreChangesBranchGroup" priority="0x0000">
        <Parent guid="LoreVS" id="LoreChangesToolbar"/>
      </Group>
      <!-- Group on the Lore Changes tool window toolbar that holds its buttons. -->
      <Group guid="LoreVS" id="LoreChangesToolbarGroup" priority="0x0100">
        <Parent guid="LoreVS" id="LoreChangesToolbar"/>
      </Group>
      <!-- Group on the Lore History tool window toolbar that holds its buttons. -->
      <Group guid="LoreVS" id="LoreHistoryToolbarGroup" priority="0x0100">
        <Parent guid="LoreVS" id="LoreHistoryToolbar"/>
      </Group>
    </Groups>

    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <!-- Onboarding entry point. Invoked programmatically by the publish workflow
           (IVsSccPublish.BeginPublishWorkflowAsync), so it is kept out of the context menu
           via DefaultInvisible while remaining routable by command id. -->
      <Button guid="LoreVS" id="AddToLoreCommand" priority="0x0100" type="Button">
        <Parent guid="LoreVS" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Add" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Add to Lore Source Control</ButtonText>
          <LocCanonicalName>.LoreVS.AddToLoreSourceControl</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="CloneCommand" priority="0x0105" type="Button">
        <Parent guid="LoreVS" id="LoreFileMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Download" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Clone Lore Repository...</ButtonText>
          <LocCanonicalName>.LoreVS.CloneLoreRepository</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="CommitToLoreCommand" priority="0x0110" type="Button">
        <Parent guid="LoreVS" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="SaveAll" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Commit to Lore...</ButtonText>
          <LocCanonicalName>.LoreVS.CommitToLore</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="IgnoreAndUntrackCommand" priority="0x0115" type="Button">
        <Parent guid="LoreVS" id="LoreFileGroup" />
        <Icon guid="ImageCatalogGuid" id="HideMember" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Ignore and Untrack Item</ButtonText>
          <LocCanonicalName>.LoreVS.IgnoreAndUntrackItem</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="UndoChangesCommand" priority="0x0118" type="Button">
        <Parent guid="LoreVS" id="LoreFileGroup" />
        <Icon guid="ImageCatalogGuid" id="Undo" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Undo Changes</ButtonText>
          <LocCanonicalName>.LoreVS.UndoChanges</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="CompareUnmodifiedCommand" priority="0x0119" type="Button">
        <Parent guid="LoreVS" id="LoreFileGroup" />
        <Icon guid="ImageCatalogGuid" id="CompareFiles" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Compare with Unmodified</ButtonText>
          <LocCanonicalName>.LoreVS.CompareWithUnmodified</LocCanonicalName>
        </Strings>
      </Button>

      <!-- Opens the read-only Lore History tool window for the current repository. Gated to Lore
           repositories via the visibility constraint below so it is hidden elsewhere. -->
      <Button guid="LoreVS" id="ShowHistoryCommand" priority="0x0120" type="Button">
        <Parent guid="LoreVS" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="History" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>View History...</ButtonText>
          <LocCanonicalName>.LoreVS.ViewHistory</LocCanonicalName>
        </Strings>
      </Button>

      <!-- Branch dropdown on the Lore Changes toolbar; shows the current branch name and
           opens the switch/create/merge menu when clicked. -->
      <Button guid="LoreVS" id="BranchCommand" priority="0x0100" type="Button">
        <Parent guid="LoreVS" id="LoreChangesBranchGroup" />
        <Icon guid="ImageCatalogGuid" id="Branch" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Branch</ButtonText>
          <LocCanonicalName>.LoreVS.Branch</LocCanonicalName>
        </Strings>
      </Button>

      <!-- Lore Changes tool window toolbar buttons. -->
      <Button guid="LoreVS" id="PullCommand" priority="0x0100" type="Button">
        <Parent guid="LoreVS" id="LoreChangesToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Download" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Pull</ButtonText>
          <LocCanonicalName>.LoreVS.Pull</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="PushCommand" priority="0x0110" type="Button">
        <Parent guid="LoreVS" id="LoreChangesToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Upload" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Push</ButtonText>
          <LocCanonicalName>.LoreVS.Push</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="LoreVS" id="RefreshChangesCommand" priority="0x0120" type="Button">
        <Parent guid="LoreVS" id="LoreChangesToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Refresh</ButtonText>
          <LocCanonicalName>.LoreVS.RefreshChanges</LocCanonicalName>
        </Strings>
      </Button>
      <!-- Lore History tool window toolbar: reloads the revision log on demand. -->
      <Button guid="LoreVS" id="RefreshHistoryCommand" priority="0x0100" type="Button">
        <Parent guid="LoreVS" id="LoreHistoryToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Refresh</ButtonText>
          <LocCanonicalName>.LoreVS.RefreshHistory</LocCanonicalName>
        </Strings>
      </Button>
      </Buttons>
  </Commands>

  <!-- Gate the Lore commands on the "Lore is the active source control provider" UI context.
       Visual Studio asserts the SCC provider GUID as a command UI context while Lore is active
       (the same context that auto-loads this package), so these commands are hidden whenever the
       open solution is not under Lore source control. When every command hosted by the "Lore"
       flyout is hidden, Visual Studio hides the (now empty) flyout automatically. -->
  <VisibilityConstraints>
    <VisibilityItem guid="LoreVS" id="CommitToLoreCommand" context="guidLoreUiContext" />
    <VisibilityItem guid="LoreVS" id="IgnoreAndUntrackCommand" context="guidLoreUiContext" />
    <VisibilityItem guid="LoreVS" id="UndoChangesCommand" context="guidLoreUiContext" />
    <VisibilityItem guid="LoreVS" id="CompareUnmodifiedCommand" context="guidLoreUiContext" />
    <VisibilityItem guid="LoreVS" id="ShowHistoryCommand" context="guidLoreUiContext" />
  </VisibilityConstraints>
  <CommandPlacements>
    <!-- Reuse the same anchor group (and therefore the Lore submenu) on the Open Folder
         root via the Workspace Explorer context menu (a different command set than the
         in-project folder node). -->
    <CommandPlacement guid="LoreVS" id="LoreContextGroup" priority="0x0600">
      <Parent guid="guidWorkspaceExplorerToolWindowPackageCmdSet" id="idmWSE_ContextMenu"/>
    </CommandPlacement>
    <!-- Carry the file commands inside the item-node Lore flyout, and host that flyout on project nodes too. -->
    <CommandPlacement guid="LoreVS" id="LoreFileGroup" priority="0x0700">
      <Parent guid="LoreVS" id="LoreFileSubMenu"/>
    </CommandPlacement>
    <CommandPlacement guid="LoreVS" id="LoreFileContextGroup" priority="0x0700">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE"/>
    </CommandPlacement>
    </CommandPlacements>

  <Symbols>
    <GuidSymbol name="LoreVS" value="{75c63f82-bb45-456a-be72-19ad0c8e33b4}">
      <IDSymbol name="MyMenuGroup" value="0x0001" />
      <IDSymbol name="LoreContextGroup" value="0x0002" />
      <IDSymbol name="LoreSubMenu" value="0x0003" />
      <IDSymbol name="LoreChangesToolbar" value="0x0004" />
      <IDSymbol name="LoreChangesToolbarGroup" value="0x0005" />
      <IDSymbol name="LoreChangesBranchGroup" value="0x000A" />
      <IDSymbol name="LoreFileMenuGroup" value="0x0009" />
      <IDSymbol name="AddToLoreCommand" value="0x0101" />
      <IDSymbol name="CloneCommand" value="0x0103" />
      <IDSymbol name="CommitToLoreCommand" value="0x0102" />
      <IDSymbol name="LoreFileGroup" value="0x0006" />
      <IDSymbol name="LoreFileContextGroup" value="0x0007" />
      <IDSymbol name="LoreFileSubMenu" value="0x0008" />
      <IDSymbol name="IgnoreAndUntrackCommand" value="0x010B" />
      <IDSymbol name="UndoChangesCommand" value="0x010C" />
      <IDSymbol name="CompareUnmodifiedCommand" value="0x010D" />
      <IDSymbol name="PullCommand" value="0x0108" />
      <IDSymbol name="PushCommand" value="0x0109" />
      <IDSymbol name="RefreshChangesCommand" value="0x010A" />
      <IDSymbol name="BranchCommand" value="0x010E" />
      <IDSymbol name="ShowHistoryCommand" value="0x010F" />
      <IDSymbol name="LoreHistoryToolbar" value="0x000B" />
      <IDSymbol name="LoreHistoryToolbarGroup" value="0x000C" />
      <IDSymbol name="RefreshHistoryCommand" value="0x0110" />
    </GuidSymbol>

    <!-- Workspace Explorer (Open Folder) context menu. -->
    <GuidSymbol name="guidWorkspaceExplorerToolWindowPackageCmdSet" value="{cfb400f1-5c60-4f3c-856e-180d28def0b7}">
      <IDSymbol name="idmWSE_ContextMenu" value="0x0002"/>
    </GuidSymbol>

    <!-- The command UI context Lore asserts (via IVsMonitorSelection) only while the open
         solution/folder is under Lore source control (a .lore repository was detected). The
         VisibilityConstraints above use it to gate the Lore commands (and their flyout). Must
         match LoreGuids.ControlledContextString. -->
    <GuidSymbol name="guidLoreUiContext" value="{20da6b33-19b3-48ab-9d0d-e33925c198bf}" />
  </Symbols>
</CommandTable>
